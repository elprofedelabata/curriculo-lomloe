{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curriculo-lomloe.example/schemas/ambitos-por-remision.schema.json",
  "title": "Ámbitos cuyo currículo se establece por remisión a materias",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "territorio", "etapa", "fuenteId", "criterioRepresentacion", "ambitos"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "territorio": { "type": "string", "pattern": "^[a-z]{2}-[a-z]{2}$" },
    "etapa": { "const": "eso" },
    "fuenteId": { "type": "string", "minLength": 1 },
    "criterioRepresentacion": { "type": "string", "minLength": 1 },
    "ambitos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "nombre", "cursos", "estado", "materiasBaseRefs", "incorporacionesOpcionales", "procedencia"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "nombre": { "type": "string", "minLength": 1 },
          "cursos": { "$ref": "#/$defs/cursos" },
          "estado": { "const": "remision-a-materias" },
          "materiasBaseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "incorporacionesOpcionales": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["materiaRef", "cursos", "condicion"],
              "properties": {
                "materiaRef": { "type": "string", "minLength": 1 },
                "cursos": { "$ref": "#/$defs/cursos" },
                "condicion": { "type": "string", "minLength": 1 }
              }
            }
          },
          "procedencia": {
            "type": "object", "additionalProperties": false,
            "required": ["fuenteRef", "paginas"],
            "properties": {
              "fuenteRef": { "type": "string", "minLength": 1 },
              "paginas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cursos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "enum": [3, 4] } }
  }
}
