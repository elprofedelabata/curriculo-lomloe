{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curriculo-lomloe.example/schemas/optativas-abiertas.schema.json",
  "title": "Ficha informativa de optativas con desarrollo curricular abierto",
  "description": "Inventario separado del esquema curricular de materias; no contiene competencias, criterios ni saberes oficiales cerrados.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "territorio",
    "etapa",
    "fuenteId",
    "criterioRepresentacion",
    "optativas"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "territorio": { "type": "string", "pattern": "^[a-z]{2}-[a-z]{2}$" },
    "etapa": { "type": "string", "enum": ["infantil", "primaria", "eso", "bachillerato", "cfgb"] },
    "fuenteId": { "type": "string", "minLength": 1 },
    "criterioRepresentacion": { "type": "string", "minLength": 1 },
    "optativas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "cursos", "estado"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "nombre": { "type": "string", "minLength": 1 },
          "cursos": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 2 }
          },
          "estado": { "const": "concrecion-docente" }
        }
      }
    }
  }
}
